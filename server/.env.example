# Local server settings. Keep the matching real values in server/.env only.
PORT=3000
CLIENT_ORIGIN=http://127.0.0.1:5173
MONGODB_URI=mongodb://127.0.0.1:27017/metafor_dev
SESSION_SECRET=replace-with-a-private-random-value
TOKEN_KEY=replace-with-64-hex-characters

# Spotify OAuth: add this exact callback to the Spotify Developer Dashboard.
SPOTIFY_CLIENT_ID=replace-with-your-client-id
SPOTIFY_CLIENT_SECRET=replace-with-your-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Optional integrations.
DEMO_LOGIN=true
GROQ_API_KEY=
DEEPL_API_KEY=
LASTFM_API_KEY=
