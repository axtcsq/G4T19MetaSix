# Copy this file to server/.env and fill in the values. Never commit .env.
# Values marked "from the team" are shared privately (not in Git or chat groups).

# Server
PORT=3000
# The client's address. Use 127.0.0.1, not localhost, or Spotify login fails.
CLIENT_ORIGIN=http://127.0.0.1:5173

# MongoDB Atlas, from the team. Develop against metafor_dev; only the deployed
# app uses metafor.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/metafor_dev

# Spotify app, from the team (Spotify developer dashboard > the MetaFor app).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Encrypts Spotify refresh tokens in the database, from the team. Everyone must
# use the same value, or tokens saved by someone else can't be read.
TOKEN_KEY=

# Signs login cookies. Generate your own: openssl rand -hex 32
SESSION_SECRET=

# Shows "Use the test account" on the login page. Run npm run db:seed once if
# the demo user doesn't exist yet.
DEMO_LOGIN=true
