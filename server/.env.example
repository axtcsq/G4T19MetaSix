# MetaFor server settings. Copy this file to server/.env and fill in the blanks.
# Keep .env private: it is ignored by Git. Ask the team for the shared values
# in a private message, never in a commit or a group chat.
#
# Settings already in your terminal win over this file. If one seems to be
# ignored, open a new terminal (or unset it) and restart the server.

# --- Server ---------------------------------------------------------------
# Port the API listens on. Vite forwards /api requests from the client to it.
PORT=3000
# The client's address, used for CORS and for redirects after login. Keep
# 127.0.0.1 (not localhost) and open the app there, or Spotify login fails.
CLIENT_ORIGIN=http://127.0.0.1:5173

# --- Database ---------------------------------------------------------------
# MongoDB Atlas connection string, from the team. The name at the end is the
# database: metafor_dev for development, metafor only for the deployed app.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/metafor_dev

# --- Spotify ----------------------------------------------------------------
# The MetaFor app in the Spotify developer dashboard, from the team. Everyone
# uses the same app. The client ID is public; the secret is not.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Where Spotify sends the browser after login. It must match a redirect URI
# registered in the dashboard exactly.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# --- Last.fm ----------------------------------------------------------------
# Artist genres for the personality quizzes, from Last.fm tags (Spotify no
# longer returns genres). Get a free key at https://www.last.fm/api/account/create.
# Optional: without it, quizzes treat every user as having no top genre.
LASTFM_API_KEY=

# --- Groq (AI) --------------------------------------------------------------
# Used by the Daily Mood journal helper and the Patterns AI summary. Create a
# GroqCloud API key. Keep it on the server; never put it in client code.
GROQ_API_KEY=

# --- DeepL (lyrics translation) ---------------------------------------------
# The emotion model that scores lyrics only reads English, so the mood analysis
# job (npm run analyse) translates other languages with DeepL first. A free key
# from https://www.deepl.com/pro-api is enough: each song is translated once.
# Optional: without it, non-English songs get a sound-only mood until it's set.
DEEPL_API_KEY=

# --- Security ---------------------------------------------------------------
# Encrypts users' Spotify refresh tokens in the database, from the team.
# Everyone must use the same value: with a different key, the tokens already
# stored can't be read.
TOKEN_KEY=
# Signs the login cookie, from the team (or generate your own with
# openssl rand -hex 32). The deployed app gets its own.
SESSION_SECRET=

# --- Test account -----------------------------------------------------------
# true shows "Use the test account" on the login page, which logs in as the
# demo user without Spotify. The demo user and its year of sample listening
# history come from the seed script, run from the server folder:
#   npm run db:seed                 a year of plays, up to now
#   npm run db:seed -- --days 30    only the last 30 days
# metafor_dev is already seeded. Re-run it to bring the plays up to today; it
# replaces the demo user's listens and daily moods, and nothing else. It only
# runs against a database whose name ends in _dev. Run npm run db:init first on
# a new database.
DEMO_LOGIN=true
